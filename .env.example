# Public template. Copy to .env and generate unique passwords before starting.
# Never commit the populated .env file.
MYSQL_DATABASE=reportmind
MYSQL_USER=reportmind
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_PORT=3306
PHPMYADMIN_PORT=8081
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25
DOCUMENT_STORAGE_PATH=/data/documents
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
PROCESSING_STALE_MINUTES=30
QDRANT_VERSION=v1.19.1
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=reportmind_chunks_e5_small_v1
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_PATH=/models
INDEXING_STALE_MINUTES=60
OLLAMA_VERSION=0.34.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_STATUS_TIMEOUT_SECONDS=5
OLLAMA_NUM_PREDICT=512
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=6000
RAG_MIN_SCORE=0.78
RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_POOL_SIZE=20
RAG_BM25_POOL_SIZE=20
RAG_RRF_K=60
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_SEARCH_LIMIT=5
